#DS_Store
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# TypeScript v1 declaration files
typings/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# next.js build output
.next

dist

# Playwright
playwright-report/
test-results/
.playwright-mcp/

# Ad-hoc screenshots dropped at repo root during manual/MCP-driven browser
# verification — never a deliverable. Anchored to root so images/**/*.png
# (real committed assets, e.g. images/logos/) stays tracked.
/*.png

# Local Claude Code skill installs (npx skills add ...) — machine-local
# tooling config, not meant to ship with the site.
.agents/
skills-lock.json

# Claude Code
.claude/

# Generated badge SVGs — committed only to the `badges` orphan branch
# (README pulls them via raw.githubusercontent.com/.../badges/...), never
# tracked on master. Keeping them untracked here avoids update-badges in
# deploy.yml regenerating tracked files it then needs to branch-switch past.
badges/*.svg

# Terraform local working directory (provider plugin cache) — regenerated by
# `terraform init`, never committed. .terraform.lock.hcl (provider version
# lock) IS committed, per Terraform convention — that one's intentional.
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json