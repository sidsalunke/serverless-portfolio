{
  "ci": {
    "collect": {
      "startServerCommand": "npm run serve:lhci",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/testing",
        "http://localhost:4173/ai-engineering",
        "http://localhost:4173/writing",
        "http://localhost:4173/writing/rollback-static-site-s3-cloudfront"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance":    ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility":  ["error", { "minScore": 1.0, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 1.0, "aggregationMethod": "median-run" }],
        "categories:seo":            ["error", { "minScore": 1.0, "aggregationMethod": "median-run" }]
      }
    }
  }
}
